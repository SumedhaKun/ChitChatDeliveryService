DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=8082
# Render supplies PORT; do not set it in the Render dashboard.

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chitchat-delivery-service
KAFKA_GROUP_ID=chitchat-delivery-service

# Production / Confluent Cloud cluster chitchat_cluster:
# KAFKA_BROKERS=<bootstrap server from cluster overview>
# KAFKA_SSL=true
# KAFKA_API_KEY=
# KAFKA_API_SECRET=

# Optional presence / delivery tuning
# WS_MAX_PAYLOAD_BYTES=65536
# WS_AUTH_TIMEOUT_MS=10000
# HEARTBEAT_INTERVAL_MS=30000
# CONNECTION_STALE_MS=60000
# DEDUPE_TTL_MS=300000
# DEDUPE_MAX_ENTRIES=10000
